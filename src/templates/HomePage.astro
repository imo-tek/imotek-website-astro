---
import PageLayout from '~/layouts/PageLayout.astro';
import Block from '~/components/site/Block.astro';
import ContactCta from '~/components/site/ContactCta.astro';
import ServiceCard from '~/components/site/ServiceCard.astro';
import Steps from '~/components/site/Steps.astro';

import { company, getContent } from '~/content-data';
import { localizePath } from '~/i18n';
import type { Locale } from '~/i18n';
import { organizationSchema, webSiteSchema } from '~/utils/schema';

export interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const { home, services } = getContent(locale);
const linkClass = 'font-medium text-primary hover:underline';
---

<PageLayout
  locale={locale}
  pageKey="home"
  metadata={{ ...home.seo, ignoreTitleTemplate: true }}
  schema={[organizationSchema(), webSiteSchema(locale)]}
>
  <section class="mx-auto max-w-5xl px-4 md:px-6 pt-16 pb-12 md:pt-24 md:pb-20">
    <div class="grid items-center gap-10 lg:grid-cols-[1fr_15rem]">
      <div>
        <h1 class="font-heading font-bold text-4xl md:text-6xl leading-tighter tracking-tighter text-heading">
          {home.hero.title}
        </h1>
        <p class="mt-6 max-w-3xl text-xl text-muted">{home.hero.subtitle}</p>
        <div class="mt-8 flex flex-wrap gap-4">
          <a class="btn-primary" href={localizePath('contact', locale)}>{home.hero.primaryCta}</a>
          <a class="btn" href={localizePath('services', locale)}>{home.hero.secondaryCta}</a>
        </div>
      </div>
      <!-- Decorative: three stacked layers (interface, backend, infrastructure) -->
      <svg
        class="hidden lg:block w-full text-primary"
        viewBox="0 0 240 240"
        fill="none"
        stroke="currentColor"
        stroke-width="2"
        aria-hidden="true"
        data-hero-figure
      >
        <rect x="40" y="20" width="160" height="52" rx="8"></rect>
        <path d="M56 38h44M56 52h80" stroke-linecap="round"></path>
        <path d="M120 72v22" stroke-dasharray="4 5"></path>
        <rect x="20" y="94" width="200" height="52" rx="8"></rect>
        <path d="M40 120h28M88 120h28M136 120h28" stroke-linecap="round"></path>
        <circle cx="194" cy="120" r="6"></circle>
        <path d="M120 146v22" stroke-dasharray="4 5"></path>
        <rect x="40" y="168" width="160" height="52" rx="8"></rect>
        <path d="M60 186v16M80 186v16M100 186v16" stroke-linecap="round"></path>
        <path d="M130 194h50" stroke-linecap="round"></path>
      </svg>
    </div>
  </section>

  <Block id="services" title={home.services.title}>
    <p class="-mt-2 mb-8 max-w-3xl text-lg text-muted">{home.services.intro}</p>
    <ul class="grid gap-5 sm:grid-cols-2 lg:grid-cols-3">
      {
        services.map((service) => (
          <li>
            <ServiceCard locale={locale} service={service} />
          </li>
        ))
      }
    </ul>
    <p class="mt-8">
      <a class={linkClass} href={localizePath('services', locale)}>{home.services.linkLabel}</a>
    </p>
  </Block>

  <Block id="turklex" tinted>
    <p class="text-sm font-semibold text-primary">{home.product.label}</p>
    <h2
      class="mt-2 max-w-3xl font-heading font-bold text-2xl md:text-3xl leading-tighter tracking-tighter text-heading"
    >
      {home.product.title}
    </h2>
    <div class="mt-5 max-w-3xl space-y-4 text-lg text-muted">
      {home.product.paragraphs.map((paragraph) => <p>{paragraph}</p>)}
    </div>
    <p class="mt-6 flex flex-wrap gap-x-8 gap-y-2">
      <a class={linkClass} href={localizePath('turklex', locale)}>{home.product.pageLinkLabel}</a>
      <a class={linkClass} href={company.turklexUrl}>{home.product.siteLinkLabel}</a>
    </p>
  </Block>

  <Block id="how-we-work" title={home.howWeWork.title}>
    <p class="-mt-2 mb-8 max-w-3xl text-lg text-muted">{home.howWeWork.intro}</p>
    <Steps steps={home.howWeWork.steps} />
    <p class="mt-8">
      <a class={linkClass} href={localizePath('howWeWork', locale)}>{home.howWeWork.linkLabel}</a>
    </p>
  </Block>

  <ContactCta locale={locale} cta={home.cta} />
</PageLayout>
