---
import PageLayout from '~/layouts/PageLayout.astro';
import Block from '~/components/site/Block.astro';
import ContactCta from '~/components/site/ContactCta.astro';
import FaqList from '~/components/site/FaqList.astro';
import PageHeader from '~/components/site/PageHeader.astro';
import Sections from '~/components/site/Sections.astro';
import Steps from '~/components/site/Steps.astro';

import { getContent } from '~/content-data';
import { localizePath, t } from '~/i18n';
import type { Locale } from '~/i18n';

export interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const { howWeWork: page } = getContent(locale);
---

<PageLayout
  locale={locale}
  pageKey="howWeWork"
  metadata={page.seo}
  breadcrumbs={[{ name: t(locale, 'nav.howWeWork'), path: localizePath('howWeWork', locale) }]}
>
  <PageHeader title={page.title} intro={page.intro} />
  <Block id="steps">
    <Steps steps={page.steps} />
  </Block>
  <Sections locale={locale} sections={page.sections} />
  <FaqList title={t(locale, 'service.faq')} faqs={page.faqs} />
  <ContactCta locale={locale} cta={page.cta} />
</PageLayout>
