---
import PageLayout from '~/layouts/PageLayout.astro';

import { localizePath, t } from '~/i18n';
import type { Locale } from '~/i18n';

export interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
---

<PageLayout locale={locale} metadata={{ title: t(locale, 'notFound.title'), robots: { index: false, follow: true } }}>
  <section class="mx-auto max-w-3xl px-4 md:px-6 py-24 md:py-32">
    <p class="font-heading font-bold text-6xl text-primary">404</p>
    <h1 class="mt-4 font-heading font-bold text-3xl md:text-4xl leading-tighter tracking-tighter text-heading">
      {t(locale, 'notFound.title')}
    </h1>
    <p class="mt-4 text-lg text-muted">{t(locale, 'notFound.text')}</p>
    <ul class="mt-8 flex flex-wrap gap-x-8 gap-y-3 font-medium text-primary">
      <li><a class="hover:underline" href={localizePath('home', locale)}>{t(locale, 'notFound.home')}</a></li>
      <li><a class="hover:underline" href={localizePath('services', locale)}>{t(locale, 'notFound.services')}</a></li>
      <li><a class="hover:underline" href={localizePath('contact', locale)}>{t(locale, 'notFound.contact')}</a></li>
    </ul>
  </section>
</PageLayout>
