---
import PageLayout from '~/layouts/PageLayout.astro';
import Block from '~/components/site/Block.astro';
import ContactCta from '~/components/site/ContactCta.astro';
import PageHeader from '~/components/site/PageHeader.astro';
import Sections from '~/components/site/Sections.astro';
import ServiceCard from '~/components/site/ServiceCard.astro';

import { getContent, getService } from '~/content-data';
import { localizePath, t } from '~/i18n';
import type { Locale } from '~/i18n';

export interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const { servicesHub: page } = getContent(locale);
---

<PageLayout
  locale={locale}
  pageKey="services"
  metadata={page.seo}
  breadcrumbs={[{ name: t(locale, 'nav.services'), path: localizePath('services', locale) }]}
>
  <PageHeader title={page.title} intro={page.intro} />

  {
    page.groups.map((group) => (
      <Block title={group.title}>
        <ul class="grid gap-5 lg:grid-cols-3">
          {group.serviceKeys.map((key) => (
            <li>
              <ServiceCard locale={locale} service={getService(locale, key)} showChooseIf />
            </li>
          ))}
        </ul>
      </Block>
    ))
  }

  <Sections locale={locale} sections={page.sections} />
  <ContactCta locale={locale} cta={page.cta} />
</PageLayout>
