---
import { Icon } from 'astro-icon/components';
import type { Technology } from '~/content-data';

/** A technology logo on a white tile, so dark logos stay visible in dark mode. */
export interface Props {
  tech: Technology;
  size?: 'sm' | 'md';
}

const { tech, size = 'md' } = Astro.props;
---

<span
  class:list={[
    'flex shrink-0 items-center justify-center bg-white ring-1 ring-gray-200 dark:ring-0',
    size === 'md' ? 'h-9 w-9 rounded-lg sm:h-11 sm:w-11' : 'h-6 w-6 rounded-md',
  ]}
  aria-hidden="true"
>
  <Icon
    name={tech.icon}
    class={size === 'md' ? 'h-6 w-6 sm:h-7 sm:w-7' : 'h-4 w-4'}
    style={tech.color ? `color: ${tech.color}` : undefined}
  />
</span>
