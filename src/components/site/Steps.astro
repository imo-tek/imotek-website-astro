---
import type { TitledText } from '~/content-data';

export interface Props {
  steps: TitledText[];
}

const { steps } = Astro.props;
---

<ol class="max-w-3xl space-y-6">
  {
    steps.map((step, index) => (
      <li class="flex gap-5">
        <span
          aria-hidden="true"
          class="flex h-9 w-9 flex-none items-center justify-center rounded-full border border-primary text-primary font-semibold"
        >
          {index + 1}
        </span>
        <div>
          <h3 class="font-heading font-semibold text-lg text-heading">{step.title}</h3>
          <p class="mt-1 text-muted">{step.text}</p>
        </div>
      </li>
    ))
  }
</ol>
