---
import { company } from '~/content-data';
import type { Cta } from '~/content-data';
import { localizePath, t } from '~/i18n';
import type { Locale } from '~/i18n';

export interface Props {
  locale: Locale;
  cta: Cta;
}

const { locale, cta } = Astro.props;
---

<section class="mx-auto max-w-5xl px-4 md:px-6 py-12 md:py-20">
  <div class="rounded-lg border border-gray-200 dark:border-slate-700 p-8 md:p-12">
    <h2 class="font-heading font-bold text-2xl md:text-3xl leading-tighter tracking-tighter text-heading">
      {cta.title}
    </h2>
    <p class="mt-3 max-w-2xl text-lg text-muted">{cta.text}</p>
    <div class="mt-6 flex flex-wrap items-center gap-x-6 gap-y-3">
      <a class="btn-primary" href={localizePath('contact', locale)}>{cta.button}</a>
      <span class="text-muted">
        {t(locale, 'cta.emailPrefix')}
        <a class="font-medium text-default hover:underline" href={`mailto:${company.email}`}>{company.email}</a>
      </span>
    </div>
  </div>
</section>
