---
/** A page section: optional H2 plus content, in the standard content width. */
export interface Props {
  id?: string;
  title?: string;
  /** Tinted background band. */
  tinted?: boolean;
}

const { id, title, tinted = false } = Astro.props;
---

<section
  id={id}
  class:list={[
    'scroll-mt-[72px]',
    { 'bg-blue-50/60 dark:bg-slate-900/60 border-y border-gray-100 dark:border-slate-800': tinted },
  ]}
>
  <div class="mx-auto max-w-5xl px-4 md:px-6 py-10 md:py-14">
    {
      title && (
        <h2 class="font-heading font-bold text-2xl md:text-3xl leading-tighter tracking-tighter text-heading mb-6">
          {title}
        </h2>
      )
    }
    <slot />
  </div>
</section>
