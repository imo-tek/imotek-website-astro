---
import Block from './Block.astro';
import { isPageKey, localizePath } from '~/i18n';
import type { Locale } from '~/i18n';
import type { Section } from '~/content-data';

export interface Props {
  locale: Locale;
  sections: Section[];
}

const { locale, sections } = Astro.props;
const resolve = (to: string) => (isPageKey(to) ? localizePath(to, locale) : to);
---

{
  sections.map((section) => (
    <Block id={section.id} title={section.title}>
      <div class="max-w-3xl space-y-4 text-lg text-muted">
        {section.paragraphs?.map((paragraph) => (
          <p>{paragraph}</p>
        ))}
        {section.bullets && (
          <ul class="list-disc pl-5 space-y-2">
            {section.bullets.map((bullet) => (
              <li>{bullet}</li>
            ))}
          </ul>
        )}
      </div>
      {section.items && (
        <dl class="mt-6 grid gap-x-10 gap-y-6 md:grid-cols-2">
          {section.items.map((item) => (
            <div>
              <dt class="font-heading font-semibold text-lg text-heading">{item.title}</dt>
              <dd class="mt-1 text-muted">{item.text}</dd>
            </div>
          ))}
        </dl>
      )}
      {section.link && (
        <p class="mt-6">
          <a class="font-medium text-primary hover:underline" href={resolve(section.link.to)}>
            {section.link.label}
          </a>
        </p>
      )}
    </Block>
  ))
}
