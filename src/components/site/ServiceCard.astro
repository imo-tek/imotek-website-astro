---
import type { Service } from '~/content-data';
import { localizePath, serviceRouteKey, t } from '~/i18n';
import type { Locale } from '~/i18n';

export interface Props {
  locale: Locale;
  service: Service;
  /** Show the "choose this if" line (services hub). */
  showChooseIf?: boolean;
  /** Heading level of the card title. */
  heading?: 'h2' | 'h3';
}

const { locale, service, showChooseIf = false, heading: Heading = 'h3' } = Astro.props;
---

<article
  class="relative flex h-full flex-col rounded-lg border border-gray-200 dark:border-slate-700 p-6 transition hover:border-primary dark:hover:border-primary"
>
  <Heading class="font-heading font-semibold text-xl text-heading">
    <a class="after:absolute after:inset-0" href={localizePath(serviceRouteKey(service.key), locale)}>
      {service.navTitle}
    </a>
  </Heading>
  <p class="mt-3 text-muted">{service.summary}</p>
  {
    showChooseIf && (
      <p class="mt-4 text-sm">
        <span class="font-semibold">{t(locale, 'service.chooseIf')}</span> {service.chooseIf}
      </p>
    )
  }
</article>
