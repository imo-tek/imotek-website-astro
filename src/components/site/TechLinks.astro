---
import TechIcon from '~/components/site/TechIcon.astro';

import { getTechnology } from '~/content-data';
import { localizePath } from '~/i18n';
import type { Locale } from '~/i18n';

export interface Props {
  locale: Locale;
  /** Keys from `content-data/technologies.ts`; each links to its anchor on the technologies page. */
  techKeys: string[];
}

const { locale, techKeys } = Astro.props;
const base = localizePath('technologies', locale);
---

<ul class="flex flex-wrap gap-2">
  {
    techKeys.map((key) => {
      const tech = getTechnology(locale, key);
      return (
        <li>
          <a
            lang="en"
            class="inline-flex items-center gap-2 rounded-full border border-gray-300 dark:border-slate-600 py-1 pl-1 pr-4 text-sm font-medium hover:border-primary hover:text-primary"
            href={`${base}#${key}`}
          >
            <TechIcon tech={tech} size="sm" />
            {tech.name}
          </a>
        </li>
      );
    })
  }
</ul>
