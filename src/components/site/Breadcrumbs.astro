---
import { t } from '~/i18n';
import type { Locale } from '~/i18n';
import type { Crumb } from '~/utils/schema';

export interface Props {
  locale: Locale;
  /** Full trail starting with the home page; the last item is the current page. */
  items: Crumb[];
}

const { locale, items } = Astro.props;
---

<nav aria-label={t(locale, 'nav.breadcrumb')} class="mx-auto max-w-5xl px-4 md:px-6 pt-8 text-sm text-muted">
  <ol class="flex flex-wrap items-center gap-x-2 gap-y-1">
    {
      items.map((item, index) => (
        <li class="flex items-center gap-x-2">
          {index > 0 && <span aria-hidden="true">/</span>}
          {index === items.length - 1 ? (
            <span aria-current="page">{item.name}</span>
          ) : (
            <a class="hover:underline hover:text-default" href={item.path}>
              {item.name}
            </a>
          )}
        </li>
      ))
    }
  </ol>
</nav>
