---
import { company } from '~/content-data';
import { ROUTES } from '~/i18n';
import type { Locale } from '~/i18n';
import type { NavLink } from '~/navigation';

export interface Props {
  locale: Locale;
  links: Array<{ title: string; links: NavLink[] }>;
  secondaryLinks: NavLink[];
  footNote: string;
}

const { locale, links, secondaryLinks, footNote } = Astro.props;
const linkClass =
  'text-muted hover:text-gray-700 hover:underline dark:text-gray-400 transition duration-150 ease-in-out';
---

<footer class="relative border-t border-gray-200 dark:border-slate-800 not-prose">
  <div class="relative max-w-7xl mx-auto px-4 sm:px-6 dark:text-slate-300">
    <div class="grid grid-cols-12 gap-4 gap-y-8 sm:gap-8 py-8 md:py-12">
      <div class="col-span-12 lg:col-span-5">
        <div class="mb-2">
          <a class="inline-block font-bold text-xl" lang="en" href={ROUTES.home[locale]}>{company.brand}</a>
        </div>
        <address class="text-sm text-muted not-italic leading-relaxed">
          {company.legalName}<br />
          {company.address.full}<br />
          <a class={linkClass} href={`mailto:${company.email}`}>{company.email}</a>
          {' · '}
          <a class={linkClass} href={company.phoneHref}>{company.phone}</a>
        </address>
      </div>
      {
        links.map(({ title, links }) => (
          <div class="col-span-6 md:col-span-4 lg:col-span-3">
            <div class="dark:text-gray-300 font-medium mb-2">{title}</div>
            <ul class="text-sm">
              {links.map(({ text, href }) => (
                <li class="mb-2">
                  <a class={linkClass} href={href}>
                    {text}
                  </a>
                </li>
              ))}
            </ul>
          </div>
        ))
      }
    </div>
    <div class="md:flex md:items-center md:justify-between py-6 md:py-8 text-sm text-muted">
      <div>{footNote}</div>
      <ul class="flex gap-x-4 mt-2 md:mt-0">
        {
          secondaryLinks.map(({ text, href }) => (
            <li>
              <a class={linkClass} href={href}>
                {text}
              </a>
            </li>
          ))
        }
        <li>
          <a class={linkClass} href={`${ROUTES.home[locale]}rss.xml`}> RSS </a>
        </li>
      </ul>
    </div>
  </div>
</footer>
